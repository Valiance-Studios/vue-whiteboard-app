rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Allowlist ids are lowercase emails, so a differently cased sign-in still matches.
    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    // Signing in is open to any Google account; using Firestore is limited to allowlisted, verified emails.
    function isAllowed() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowedUsers/$(signedInEmail()));
    }

    // A board's owner is the user who created it.
    function isOwner(data) {
      return data.createdAt.uid == request.auth.uid;
    }

    function isStampedBySelf(stamp) {
      return stamp.uid == request.auth.uid && stamp.time == request.time;
    }

    // Marker color runs, e.g. `blue:24,red:7`. Whether they match the text's length cannot be checked here,
    // so the client reads mismatched runs as the default ink.
    // Keep the inks in sync with MARKER_INKS in src/constants/markers.ts, and the max length with BOARD_INKS_MAX_LENGTH.
    function isValidInks(inks) {
      return inks is string
        && inks.size() <= 20000
        && inks.matches('((black|blue|red|green|purple|orange):[1-9][0-9]{0,5}(,(black|blue|red|green|purple|orange):[1-9][0-9]{0,5})*)?');
    }

    function hasValidFields(data) {
      return data.keys().hasOnly(['title', 'titleSearchable', 'content', 'inks', 'hasSketches', 'createdAt', 'updatedAt'])
        && data.title is string
        // Keep the max lengths in sync with BOARD_TITLE_MAX_LENGTH and BOARD_CONTENT_MAX_LENGTH in src/constants/board.ts.
        && data.title.trim().size() > 0
        && data.title.size() <= 100
        && data.titleSearchable == data.title.lower()
        && data.content is string
        && data.content.size() <= 100000
        && (!('inks' in data) || isValidInks(data.inks))
        && (!('hasSketches' in data) || data.hasSketches is bool);
    }

    // Limits how often one board can be written. The first edit after creating a board is exempt,
    // so writing straight away on a new board is never rejected.
    // Keep the interval in sync with BOARD_MIN_SAVE_INTERVAL_MS in src/constants/board.ts.
    function isOutsideSaveInterval(data) {
      return data.updatedAt == data.createdAt
        || request.time > data.updatedAt.time + duration.value(500, 'ms');
    }

    // The allowlist is managed in the Firebase console. Users may only check whether they themselves are on it.
    match /allowedUsers/{email} {
      allow get: if isSignedIn() && signedInEmail() == email;
    }

    // Keep in sync with recordAccessRequest in src/firebase/access.ts.
    function isValidAccessRequest(data) {
      return data.keys().hasOnly(['email', 'displayName', 'requestedAt'])
        && data.email == request.auth.token.email
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 200))
        && data.requestedAt == request.time;
    }

    // Denied sign-ins, which the app records for the owner to review in the console. Users write only
    // their own request, at most once a minute; nobody reads, lists or deletes requests through the app.
    match /accessRequests/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isValidAccessRequest(request.resource.data);

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && isValidAccessRequest(request.resource.data)
        && request.time > resource.data.requestedAt + duration.value(1, 'm');
    }

    match /boards/{boardId} {
      // Reading a missing board is denied the same as reading another user's board,
      // so the existence of other users' boards is never revealed.
      // List queries must filter on `createdAt.uid == <own uid>` to be allowed.
      allow read: if isAllowed() && isOwner(resource.data);

      allow create: if isAllowed()
        && hasValidFields(request.resource.data)
        && isStampedBySelf(request.resource.data.createdAt)
        && isStampedBySelf(request.resource.data.updatedAt);

      allow update: if isAllowed()
        && isOwner(resource.data)
        && isOutsideSaveInterval(resource.data)
        && hasValidFields(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && isStampedBySelf(request.resource.data.updatedAt);

      allow delete: if isAllowed() && isOwner(resource.data);

      // Sketch strokes, one document each. Strokes are only created and deleted, never edited.
      // Keep in sync with FirestoreSketchRepository and encodePoints (src/utils/strokes.ts).
      match /strokes/{strokeId} {
        function isValidStroke(data) {
          return data.keys().hasOnly(['ownerUid', 'ink', 'pen', 'points', 'drawnAt'])
            && data.ownerUid == request.auth.uid
            && data.ink in ['black', 'blue', 'red', 'green', 'purple', 'orange']
            && data.pen is bool
            && data.points is string
            && data.points.size() <= 20000
            && data.points.matches('-?[0-9]+(,-?[0-9]+)*')
            && data.drawnAt is int;
        }

        // The stroke's owner is stored on it, so reads and deletes need no read of the board.
        allow read, delete: if isAllowed() && resource.data.ownerUid == request.auth.uid;

        // Creating checks the board too, so nobody can add strokes under someone else's board.
        allow create: if isAllowed()
          && isValidStroke(request.resource.data)
          && isOwner(get(/databases/$(database)/documents/boards/$(boardId)).data);
      }
    }
  }
}
