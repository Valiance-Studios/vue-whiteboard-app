{
  "name": "vue-whiteboard-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "emulators": "node scripts/with-emulators.ts --keep-running --project demo-whiteboard-app --only auth,firestore -- node scripts/seed-emulators.ts",
    "emulators:stop": "node scripts/stop-emulators.ts",
    "icons": "node scripts/generate-icons.ts",
    "test:unit": "vitest",
    "test:e2e": "node scripts/with-emulators.ts --project demo-whiteboard-app --only auth,firestore -- playwright test",
    "deploy": "firebase deploy --project dev --only hosting,firestore",
    "deploy:hosting": "firebase deploy --project dev --only hosting",
    "deploy:rules": "firebase deploy --project dev --only firestore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:emulator": "node scripts/with-emulators.ts --project demo-whiteboard-app --only firestore -- vitest run --config vitest.emulator.config.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-document": "^3.32.1",
    "@tiptap/extension-paragraph": "^3.32.1",
    "@tiptap/extension-text": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/vue-3": "^3.32.1",
    "firebase": "^13.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sass-embedded": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
