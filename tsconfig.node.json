{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.ts", "vitest.config.ts", "vitest.rules.config.ts", "playwright.config.ts", "tests/e2e/**/*", "tests/rules/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
