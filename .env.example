# Copy to .env.production.local and fill in from
# Firebase console > Project settings > Your apps > Web app config.
#
# Use .env.production.local, not .env.local: Vite loads .env.local in every mode, so real
# credentials there would send `npm run dev` and the E2E tests at real Firebase instead of
# the emulators. Build settings that are not secret live in the committed .env.production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Leave empty for the project's (default) database; set it to use a named database.
# Already set to vue-whiteboard-app in .env.production.
VITE_FIREBASE_DATABASE_ID=
VITE_USE_FIREBASE_EMULATORS=false
