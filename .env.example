# Template for a new env file. Copy it to the file you need, e.g. `.env.production` once a production
# Firebase project exists, and fill it in from the Firebase console > Project settings > Your apps
# (web app). See "Environment Files" in docs/DEVELOPMENT.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=vue-whiteboard-app
# reCAPTCHA Enterprise site key registered with App Check for this web app (public).
VITE_APPCHECK_SITE_KEY=
