# Local development against the Firebase Local Emulator Suite.
# The "demo-" project prefix ensures no real Firebase resources are used.
# Override with real values in .env.local (not committed).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-whiteboard-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-whiteboard-app
VITE_FIREBASE_STORAGE_BUCKET=demo-whiteboard-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_FIREBASE_EMULATORS=true
# Matches production, so dev and the E2E tests exercise the named-database code path.
VITE_FIREBASE_DATABASE_ID=vue-whiteboard-app
