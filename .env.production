# Production: for a future production Firebase project. None exists yet ("staging is production"), so
# deploys use `.env.staging` and nothing builds with these values. Fill them in from that project's web
# app config once it exists.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=vue-whiteboard-app
# reCAPTCHA Enterprise site key registered with App Check for this web app (public).
VITE_APPCHECK_SITE_KEY=
